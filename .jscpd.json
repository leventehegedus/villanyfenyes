{
  "threshold": 3,
  "minTokens": 60,
  "minLines": 6,
  "gitignore": true,
  "reporters": ["console"],
  "format": ["typescript", "tsx", "javascript"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "src/components/ui/**",
    "**/__fixtures__/**",
    "**/__snapshots__/**",
    "public/data/**",
    "e2e/fixtures/**"
  ],
  "path": ["src", "scripts", "e2e"]
}
